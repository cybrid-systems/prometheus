; examples/08-long-n-100/main.aura
;
; Phase 5 denseness soak ladder top — N=100 continuous rebind.
; Axes: A B C F. Core escapes must remain 0.
;
; Run: ./scripts/run-aura.sh examples/08-long-n-100/main.aura

(require "prometheus-min" all:)

(prom:stats-reset!)

(display "=== Prometheus 08-long-n-100: N=100 continuous rebind soak ===")
(newline)

(define N-LEAVES 150)
(define ROUNDS 100)
(define SAMPLE-ARG 7)
(define MIN-NODES 700)

(display "knobs: n-leaves=")
(display N-LEAVES)
(display " rounds=")
(display ROUNDS)
(newline)

(let* ((installed (prom:install-scale-subject N-LEAVES))
       (nc0 (prom:node-count))
       (init-ok (and installed
                     (prom:check-true installed)
                     (prom:check-ge nc0 MIN-NODES)
                     (prom:check-eq (prom:def-count) (+ N-LEAVES 1)))))
  (display "install: nodes=")
  (display nc0)
  (display " ok=")
  (display init-ok)
  (newline)

  (if (not init-ok)
    (begin
      (display "FAIL: install")
      (newline)
      (display "RESULT fail example=08-long-n-100")
      (newline))
    (begin
      (let* ((env (prom:incremental-envelope! ROUNDS N-LEAVES SAMPLE-ARG))
             (cont (prom:alist-ref ":continuous" env (list)))
             (okc (prom:alist-ref ":ok_count" cont 0))
             (failc (prom:alist-ref ":fail_count" cont 0))
             (elapsed (prom:alist-ref ":elapsed_ms" env 0))
             (avg (prom:alist-ref ":avg_ms_per_round" env 0))
             (envelope-ok (prom:alist-ref ":envelope_ok" env #f))
             (d-gen (prom:alist-ref ":d_gen_bump" env 0))
             (full-dom (prom:alist-ref ":full_dominates_partial" env #f))
             (cont-ok (and (prom:check-eq okc ROUNDS)
                           (prom:check-eq failc 0)
                           (prom:check-true envelope-ok)
                           (prom:check-ge d-gen 1)
                           (prom:check-true (not full-dom))))
             (pr (prom:poison-restore! SAMPLE-ARG (* SAMPLE-ARG 3) N-LEAVES))
             (pr-ok (and (prom:check-true (prom:alist-ref ":poison_ok" pr #f))
                         (prom:check-true (prom:alist-ref ":restored_ok" pr #f))))
             (v-nodes (prom:check-true (prom:validate-nodes-pass?)))
             (v-own (prom:check-true (prom:validate-ownership-pass?)))
             (esc-ok (prom:check-eq (prom:stats-ref "escapes") 0)))
        (display "soak: ok=")
        (display okc)
        (display " fail=")
        (display failc)
        (display " elapsed_ms=")
        (display elapsed)
        (display " avg_ms=")
        (display avg)
        (display " envelope=")
        (display envelope-ok)
        (display " d_gen=")
        (display d-gen)
        (newline)
        (display "poison-restore ok=")
        (display pr-ok)
        (display " validate=")
        (display v-nodes)
        (display "/")
        (display v-own)
        (display " escapes=")
        (display (prom:stats-ref "escapes"))
        (newline)
        (display "stats: ")
        (write (prom:stats-alist))
        (newline)

        (let ((all-ok
                (and init-ok cont-ok pr-ok v-nodes v-own esc-ok
                     (= (prom:stats-ref "correctness_fail") 0)
                     (= (prom:stats-ref "mut_fail") 0)
                     (>= (prom:stats-ref "mut_ok") ROUNDS)
                     (= (prom:stats-ref "escapes") 0))))
          (if all-ok
            (begin
              (display "PASS: long-n soak N=100 (escapes=0)")
              (newline)
              (display "RESULT pass example=08-long-n-100 escapes=0 rounds=")
              (display ROUNDS)
              (display " nodes=")
              (display (prom:node-count))
              (display " elapsed_ms=")
              (display elapsed)
              (display " avg_ms=")
              (display avg)
              (newline))
            (begin
              (display "FAIL: long-n-100 denseness soak")
              (newline)
              (display "RESULT fail example=08-long-n-100")
              (newline)
              (display "  cont=")
              (display cont-ok)
              (display " pr=")
              (display pr-ok)
              (display " escapes=")
              (display (prom:stats-ref "escapes"))
              (newline))))))))
