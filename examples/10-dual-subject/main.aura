; examples/10-dual-subject/main.aura
;
; Denseness: two mutable subjects on one scale FlatAST.
; Logic in prom:dual-subject-soak! (module free-vars survive set-code).
;
; Run: ./scripts/run-aura.sh examples/10-dual-subject/main.aura

(require "prometheus-min" all:)

(prom:stats-reset!)

(display "=== Prometheus 10-dual-subject: isolated dual rebind ===")
(newline)

(let* ((installed (prom:install-dual-subjects 60))
       (nc (prom:node-count))
       (dc (prom:def-count))
       (init-ok (and installed (>= nc 300) (= dc 62))))
  (display "install ok=")
  (display init-ok)
  (display " nodes=")
  (display nc)
  (display " defs=")
  (display dc)
  (newline)

  (if (not init-ok)
    (begin
      (display "FAIL: install dual")
      (newline)
      (display "RESULT fail example=10-dual-subject")
      (newline))
    (let* ((soak (prom:dual-subject-soak! 16 7 60))
           (iso-a (prom:alist-ref ":iso_a_ok" soak #f))
           (iso-b (prom:alist-ref ":iso_b_ok" soak #f))
           (okc (prom:alist-ref ":ok_count" soak 0))
           (failc (prom:alist-ref ":fail_count" soak 0))
           (elapsed (prom:alist-ref ":elapsed_ms" soak 0))
           (all-soak (prom:alist-ref ":all_ok" soak #f))
           (v-ok (and (prom:validate-nodes-pass?)
                      (prom:validate-ownership-pass?)))
           (esc-ok (= (prom:stats-ref "escapes") 0))
           (all-ok (and all-soak v-ok esc-ok)))
      (display "soak: ")
      (write soak)
      (newline)
      (display "iso_a=")
      (display iso-a)
      (display " iso_b=")
      (display iso-b)
      (display " okc=")
      (display okc)
      (display " failc=")
      (display failc)
      (display " elapsed_ms=")
      (display elapsed)
      (newline)
      (display "validate=")
      (display v-ok)
      (display " escapes=")
      (display (prom:stats-ref "escapes"))
      (newline)
      (display "stats: ")
      (write (prom:stats-alist))
      (newline)
      (if all-ok
        (begin
          (display "PASS: dual-subject isolation under continuous rebind (escapes=0)")
          (newline)
          (display "RESULT pass example=10-dual-subject escapes=0 rounds=16")
          (display " elapsed_ms=")
          (display elapsed)
          (newline))
        (begin
          (display "FAIL: dual-subject denseness")
          (newline)
          (display "RESULT fail example=10-dual-subject")
          (newline)
          (display "  soak_all=")
          (display all-soak)
          (display " v=")
          (display v-ok)
          (display " esc=")
          (display esc-ok)
          (newline))))))
