; examples/06-scale-soak/main.aura
;
; Phase 5 denseness soak — multi-round continuous rebind on large FlatAST.
; Axes: A B C F (core path; no live LLM required).
;
; Ladder rung N=25:
;   install scale+subject → continuous *3/*5 rebind → cost delta envelope →
;   poison+restore → escapes must stay 0 on core path
;
; Run: ./scripts/run-aura.sh examples/06-scale-soak/main.aura

(require "prometheus-min" all:)

(prom:stats-reset!)

(display "=== Prometheus 06-scale-soak: N=25 continuous rebind soak ===")
(newline)
(display "prom:min-version=")
(display prom:min-version)
(newline)

(define N-LEAVES 100)
(define ROUNDS 25)
(define SAMPLE-ARG 7)
(define MIN-NODES 500)

(display "knobs: n-leaves=")
(display N-LEAVES)
(display " rounds=")
(display ROUNDS)
(newline)

(let* ((installed (prom:install-scale-subject N-LEAVES))
       (nc0 (prom:node-count))
       (dc0 (prom:def-count))
       (init-ok (and installed
                     (prom:check-true installed)
                     (prom:check-ge nc0 MIN-NODES)
                     (prom:check-eq dc0 (+ N-LEAVES 1)))))
  (display "install: nodes=")
  (display nc0)
  (display " defs=")
  (display dc0)
  (display " ok=")
  (display init-ok)
  (newline)

  (if (not init-ok)
    (begin
      (display "FAIL: install")
      (newline)
      (display "RESULT fail example=06-scale-soak")
      (newline))
    (begin
      ; ── Continuous soak with cost envelope ──
      (let* ((env (prom:incremental-envelope! ROUNDS N-LEAVES SAMPLE-ARG))
             (cont (prom:alist-ref ":continuous" env (list)))
             (okc (prom:alist-ref ":ok_count" cont 0))
             (failc (prom:alist-ref ":fail_count" cont 0))
             (elapsed (prom:alist-ref ":elapsed_ms" env 0))
             (avg (prom:alist-ref ":avg_ms_per_round" env 0))
             (envelope-ok (prom:alist-ref ":envelope_ok" env #f))
             (d-gen (prom:alist-ref ":d_gen_bump" env 0))
             (d-partial (prom:alist-ref ":d_partial_relower" env 0))
             (full-dom (prom:alist-ref ":full_dominates_partial" env #f))
             (cont-ok (and (prom:check-eq okc ROUNDS)
                           (prom:check-eq failc 0)
                           (prom:check-true envelope-ok)
                           (prom:check-ge d-gen 1)
                           (prom:check-true (not full-dom)))))
        (display "soak continuous: ok=")
        (display okc)
        (display " fail=")
        (display failc)
        (display " elapsed_ms=")
        (display elapsed)
        (display " avg_ms=")
        (display avg)
        (newline)
        (display "envelope_ok=")
        (display envelope-ok)
        (display " d_gen=")
        (display d-gen)
        (display " d_partial=")
        (display d-partial)
        (display " full_dom=")
        (display full-dom)
        (newline)

        ; ── Poison + restore mid/end soak ──
        (let* ((pr (prom:poison-restore! SAMPLE-ARG (* SAMPLE-ARG 3) N-LEAVES))
               (pr-ok (and (prom:check-true (prom:alist-ref ":poison_ok" pr #f))
                           (prom:check-true (prom:alist-ref ":restored_ok" pr #f))))
               (v-nodes (prom:check-true (prom:validate-nodes-pass?)))
               (v-own (prom:check-true (prom:validate-ownership-pass?)))
               (esc-ok (prom:check-eq (prom:stats-ref "escapes") 0)))
          (display "poison-restore: ")
          (write pr)
          (newline)
          (display "pr_ok=")
          (display pr-ok)
          (display " validate=")
          (display v-nodes)
          (display "/")
          (display v-own)
          (display " escapes=")
          (display (prom:stats-ref "escapes"))
          (newline)

          (display "stats: ")
          (write (prom:stats-alist))
          (newline)

          (let ((all-ok
                  (and init-ok cont-ok pr-ok v-nodes v-own esc-ok
                       (= (prom:stats-ref "correctness_fail") 0)
                       (= (prom:stats-ref "mut_fail") 0)
                       (>= (prom:stats-ref "mut_ok") ROUNDS)
                       (= (prom:stats-ref "escapes") 0))))
            (if all-ok
              (begin
                (display "PASS: scale soak N=25 continuous rebind (escapes=0)")
                (newline)
                (display "RESULT pass example=06-scale-soak escapes=0 rounds=")
                (display ROUNDS)
                (display " nodes=")
                (display (prom:node-count))
                (display " elapsed_ms=")
                (display elapsed)
                (display " avg_ms=")
                (display avg)
                (newline))
              (begin
                (display "FAIL: scale soak denseness")
                (newline)
                (display "RESULT fail example=06-scale-soak")
                (newline)
                (display "  init=")
                (display init-ok)
                (display " cont=")
                (display cont-ok)
                (display " pr=")
                (display pr-ok)
                (display " escapes=")
                (display (prom:stats-ref "escapes"))
                (newline)))))))))
