; lib/prometheus-min.aura — Phase 1–4 facade (Axes A–F partial)
;
; (require "prometheus-min" all:)
;
; Note: prometheus-llm is also requireable directly for propose-edge probes.

(export prom:stats prom:stats-reset! prom:stats-ref prom:stats-bump!
        prom:stats-set! prom:stats-alist prom:alist-ref
        prom:time-call prom:ops-per-sec prom:ops-per-ms
        prom:check-eq prom:check-true prom:check-ge
        prom:scale-version prom:mutate-version prom:cost-version
        prom:llm-version prom:min-version
        prom:build-leaves-src prom:build-deep-src prom:build-scale-src
        prom:build-dual-subject-src prom:install-dual-subjects
        prom:install-source
        prom:node-count prom:def-count prom:generation
        prom:validate-nodes-pass? prom:validate-ownership-pass?
        prom:scale-snapshot
        prom:observe-flatast! prom:install-and-observe
        prom:safety-ok? prom:snapshot prom:restore
        prom:rebind-safe prom:rebind-live prom:rebind-apply
        prom:build-subject-src prom:install-scale-subject
        prom:body-scale prom:want-scale
        prom:sample-subject prom:leaves-intact?
        prom:continuous-rebind! prom:poison-restore!
        prom:mutation-total prom:dual-subject-soak!
        prom:hash-num prom:stats-num prom:engine-group-num
        prom:observe-cost! prom:cost-delta prom:cost-alist-ref
        prom:incremental-envelope!
        prom:propose-mode prom:proposal-kind prom:proposal-name
        prom:proposal-body prom:proposal-summary prom:proposal-source
        prom:proposal-errors prom:proposal-valid?
        prom:body-double prom:body-triple prom:body-quint
        prom:body-sept prom:body-poison
        prom:propose-rule prom:propose-stub prom:propose
        prom:parse-proposal-text prom:proposal-prompt
        prom:execute-proposal prom:note-edge-escape!)

(require "prometheus-measure" all:)
(require "prometheus-scale" all:)
(require "prometheus-mutate" all:)
(require "prometheus-cost" all:)
(require "prometheus-llm" all:)

(define prom:min-version 4)
